---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/blog/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/bio/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/links/</loc>
  </url>
  {% for post in collections.posts %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ post.date | htmlDateString }}</lastmod>
  </url>
  {% endfor %}
  {% for group in collections.postsByYearMonth %}
  <url>
    <loc>{{ site.url }}/blog/archive/{{ group.year }}/{{ group.month }}/</loc>
  </url>
  {% endfor %}
  {% for slug in collections.postsByCategory %}
  <url>
    <loc>{{ site.url }}/blog/category/{{ slug }}/</loc>
  </url>
  {% endfor %}
</urlset>
