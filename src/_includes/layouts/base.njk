<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.ga }}"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '{{ site.ga }}');
    </script>

    {%- set metaTitle = title or site.name -%}
    {%- set metaDescription = description or excerpt or site.description -%}
    {%- set metaImage = site.url ~ (ogImage or image or site.defaultOgImage) -%}
    {%- set metaImageAlt = imageAlt or title or site.name -%}
    {%- set metaUrl = site.url ~ page.url -%}

    <title>{% if title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }} | Official Author Site{% endif %}</title>
    <meta name="description" content="{{ metaDescription }}">
    <meta name="author" content="{{ site.author.name }}">
    {% if keywords %}<meta name="keywords" content="{% if keywords is string %}{{ keywords }}{% else %}{{ keywords | join(', ') }}{% endif %}">{% endif %}

    <!-- Canonical -->
    <link rel="canonical" href="{{ metaUrl }}">

    <!-- Open Graph -->
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:locale" content="{{ site.locale }}">
    <meta property="og:title" content="{{ metaTitle }}">
    <meta property="og:description" content="{{ metaDescription }}">
    <meta property="og:url" content="{{ metaUrl }}">
    <meta property="og:type" content="{% block ogtype %}website{% endblock %}">
    <meta property="og:image" content="{{ metaImage }}">
    <meta property="og:image:alt" content="{{ metaImageAlt }}">

    <!-- X card (X falls back to the og: tags for title, description and image) -->
    <meta name="twitter:card" content="summary_large_image">
    {% if site.social.x %}
    <meta name="twitter:site" content="{{ site.social.x }}">
    <meta name="twitter:creator" content="{{ site.social.x }}">
    {% endif %}

    <!-- Fediverse: author byline on Mastodon link cards, and profile link verification -->
    {% if site.social.mastodon %}<meta name="fediverse:creator" content="{{ site.social.mastodon }}">{% endif %}
    {% if site.social.mastodonUrl %}<link rel="me" href="{{ site.social.mastodonUrl }}">{% endif %}

    <!-- RSS autodiscovery -->
    <link rel="alternate" type="application/atom+xml" title="{{ site.name }} Blog" href="{{ site.url }}{{ site.feedUrl }}">

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="icon" href="/favicon.ico">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Cormorant+Garamond:wght@300;600&display=swap" rel="stylesheet">

    <!-- Shared styles -->
    <link rel="stylesheet" href="/assets/css/site.css">

    {% block head %}{% endblock %}
</head>
<body>

    {% include "partials/header.njk" %}

    {% block content %}{% endblock %}

    {% include "partials/footer.njk" %}

</body>
</html>
