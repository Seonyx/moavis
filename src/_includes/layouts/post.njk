{% extends "layouts/base.njk" %}

{% block ogtype %}article{% endblock %}

{% block head %}
<link rel="stylesheet" href="/assets/css/blog.css">
<link href="/pagefind/pagefind-ui.css" rel="stylesheet">
{% include "partials/jsonld-post.njk" %}
{% endblock %}

{% block content %}
<div class="blog-container">
    <main class="blog-main" data-pagefind-body>
        <article>
            <header class="post-header">
                <h1 class="post-title">{{ title }}</h1>
                <div class="post-meta">
                    <time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time>
                    {% if categories and categories.length %}
                     &mdash;
                    {% for cat in categories %}
                        <a href="/blog/category/{{ cat }}/">{{ cat | categoryDisplayName }}</a>{% if not loop.last %}, {% endif %}
                    {% endfor %}
                    {% endif %}
                </div>
            </header>

            {% if image %}
            <img src="{{ image }}" alt="{{ title }}" style="width:100%;height:auto;margin-bottom:32px;border:1px solid var(--accent-color);">
            {% endif %}

            <div class="post-body">
                {{ content | safe }}
            </div>
        </article>

        <nav class="post-nav" aria-label="Post navigation">
            {% if previousPost %}
            <a href="{{ previousPost.url }}" rel="prev">
                <span class="nav-label">Previous</span>
                {{ previousPost.data.title }}
            </a>
            {% else %}
            <span></span>
            {% endif %}

            {% if nextPost %}
            <a href="{{ nextPost.url }}" rel="next" style="text-align:right">
                <span class="nav-label">Next</span>
                {{ nextPost.data.title }}
            </a>
            {% endif %}
        </nav>
    </main>

    <aside class="blog-sidebar" data-pagefind-ignore>
        {% include "partials/sidebar.njk" %}
    </aside>
</div>
{% endblock %}
