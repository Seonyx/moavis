{#- Narration player. Expects narrationUrl and, optionally, narrationMinutes. One per page, so the label id is fixed. -#}
<figure class="narration">
  <figcaption id="narration-label">Listen to this post (AI-narrated{% if narrationMinutes %}, {{ narrationMinutes }} min{% endif %})</figcaption>
  <audio controls preload="metadata" src="{{ narrationUrl }}" aria-labelledby="narration-label">
    <a href="{{ narrationUrl }}">Download the narration (MP3)</a>
  </audio>
</figure>
