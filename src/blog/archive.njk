---
pagination:
  data: collections.postsByYearMonth
  size: 1
  alias: archiveGroup
permalink: "/blog/archive/{{ archiveGroup.year }}/{{ archiveGroup.month }}/"
eleventyComputed:
  title: "Posts from {{ archiveGroup.posts[0].date | monthName }} {{ archiveGroup.year }}"
  description: "Posts by Maureen Avis from {{ archiveGroup.posts[0].date | monthName }} {{ archiveGroup.year }}."
---
{% extends "layouts/base.njk" %}

{% block head %}
<link rel="stylesheet" href="{{ '/assets/css/blog.css' | assetUrl }}">
<link href="/pagefind/pagefind-ui.css" rel="stylesheet">
{% endblock %}

{% block content %}
<div class="blog-container">
    <main class="blog-main" data-pagefind-body>
        <h2 class="archive-heading">{{ title }}</h2>

        {% for post in archiveGroup.posts %}
            {% set post = post %}
            {% include "partials/post-card.njk" %}
        {% endfor %}
    </main>

    <aside class="blog-sidebar" data-pagefind-ignore>
        {% include "partials/sidebar.njk" %}
    </aside>
</div>
{% endblock %}
